{
  "name": "plantuml-vscode",
  "displayName": "PlantUML Toolkit (deriva)",
  "description": "PlantUML language support backed by the deriva/plantuml toolchain: tree-sitter grammar, plantuml-fmt and plantuml-lsp",
  "version": "0.4.0",
  "publisher": "deriva",
  "license": "MIT",
  "repository": "https://gitlab.semantiqa.dev/deriva/plantuml/plantuml-vscode",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "main": "./out/client/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML"
        ],
        "extensions": [
          ".puml",
          ".plantuml",
          ".iuml",
          ".wsd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plantuml",
        "scopeName": "source.plantuml",
        "path": "./syntaxes/plantuml.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "PlantUML Toolkit",
      "properties": {
        "plantuml.lsp.path": {
          "type": "string",
          "default": "plantuml-lsp",
          "description": "Command used to launch the PlantUML language server (install it with: pip install plantuml-lsp)."
        },
        "plantuml.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the language server for PlantUML documents."
        },
        "plantuml.render.engine": {
          "type": "string",
          "enum": [
            "native",
            "plantuml"
          ],
          "enumDescriptions": [
            "Bundled deterministic engine: interactive (drag, filters), self-contained, class-diagram subset.",
            "Official plantuml.jar: full PlantUML fidelity, static output. Requires Java and plantuml.render.jarPath."
          ],
          "default": "native",
          "description": "Preview rendering engine. The toolbar can switch it per panel."
        },
        "plantuml.render.jarPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to plantuml.jar for the official engine (the jar is never bundled)."
        },
        "plantuml.render.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Java executable used to run plantuml.jar."
        }
      }
    },
    "commands": [
      {
        "command": "plantuml.showPreview",
        "title": "PlantUML: Open Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "plantuml.showPreview",
          "when": "resourceLangId == plantuml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run bundle && node scripts/prepare-media.mjs",
    "test": "npm run compile && vitest run",
    "package": "vsce package --allow-missing-repository",
    "bundle": "esbuild src/webview/preview.ts --bundle --format=iife --platform=browser --outfile=media/preview.js --external:fs --external:path --external:module && esbuild src/client/extension.ts --bundle --format=cjs --platform=node --outfile=out/client/extension.js --external:vscode",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "plantuml-render": "git+https://gitlab.semantiqa.dev/deriva/plantuml/plantuml-render.git#v0.4.1",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "web-tree-sitter": "^0.26.12"
  }
}
